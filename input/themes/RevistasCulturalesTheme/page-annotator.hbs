{{> head}}
{{> navbar}}

{{!-- Añadimos la clase 'annotator-page' para manipularla con CSS --}}
<main class="page annotator-page">
   {{#page}}
      {{!-- Añadimos una clase al article --}}
      <article class="annotator-wrapper">
        <h1>{{title}}</h1>

        <div id="page-entry">
            {{{text}}}
        </div>

        {{!-- 1. Pass the dynamic domain context --}}
        <script>
          window.CUSTOM_CONTEXT = {
            siteDomain: "{{@website.baseUrl}}",
            mediaUrl: "{{@website.mediaFilesUrl}}",
            i18n: {
              searchPlaceholder: "{{translate 'custom.searchPlaceholder' fallback='Search...'}}",
              resultsFound: "{{translate 'custom.resultsFound' fallback='results found'}}",
              all: "{{translate 'custom.all' fallback='All'}}",
              clearSearch: "{{translate 'custom.clearSearch' fallback='Clear Search'}}",
              noRecordsFound: "{{translate 'custom.noRecordsFound' fallback='No records found'}}",
              noImage: "{{translate 'custom.noImage' fallback='No image'}}",
            }
          };
        </script>

        {{!-- 2. Load the data payloads --}}
        <script defer src="{{@website.mediaFilesUrl}}/contributors.js"></script>
        <script defer src="{{@website.mediaFilesUrl}}/repositories.js"></script>

        {{!-- 3. Load the compiled Web Components --}}
        <script defer src="{{js "custom-components.js"}}"></script>

      {{!-- Cierre de article corregido --}}
      </article>
   {{/page}}
</main>

{{!-- Estilos específicos para sobreescribir la restricción de ancho del tema --}}
<style>
  .annotator-page {
    /* Esto le dice al elemento que ocupe desde la primera hasta la última columna del grid del body */
    grid-column: 1 / -1 !important; 
    
    max-width: 100% !important;
    padding: 0 2vw; /* Mantiene un pequeño margen respirable a los lados en pantallas gigantes */
  }
  
  .annotator-wrapper {
    max-width: 1600px !important; 
    margin: 0 auto;
    width: 100%;
  }

  #page-entry {
    margin-top: 2rem;
  }
</style>

{{> footer}}